# Local data, experiments, checkpoints and recoverable maintenance archives.
/work/
/.work/

# Python/build caches.
__pycache__/
*.py[cod]
*.nbc
*.nbi
*.egg-info/
/build/
/dist/
/.venv/
/.pytest_cache/

# Large data/checkpoints and transient outputs do not belong in source control.
*.pkl
*.pickle
*.pkl.b2
*.p5.b2
*.vcf
*.vcf.gz
*.bcf
*.bcf.gz
*.bam
*.cram
*.fastq.gz
*.log
*.png
*.csv
*.ped

# Explicitly curated readable real-data handoffs.
!deliverables/**/*.csv
!deliverables/**/*.ped

# Editor/patch leftovers and personal coding-tool configuration.
/.agents/
/.codex/
/.claude/
/.vscode/
*.orig
*.rej
*.swp
*~
.DS_Store