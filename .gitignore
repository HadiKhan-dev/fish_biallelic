# Local data, experiments, checkpoints and recoverable maintenance archives.
/work/
/.work/

# Local publication draft, kept separately from pipeline source control.
/manuscript/

# External research checkout (also matches a symlink, not just a directory).
/claude_lab

# Python/build caches.
__pycache__/
*.py[cod]
*.nbc
*.nbi
*.egg-info/
/build/
/dist/
/haplotype_reconstruction-*/
/.venv/
/.pytest_cache/
/.ruff_cache/
/.mypy_cache/

# Large data/checkpoints and transient outputs do not belong in source control.
*.pkl
*.pickle
*.pkl.b2
*.p5.b2
*.vcf
*.vcf.gz
*.bcf
*.bcf.gz
*.bam
*.cram
*.fastq.gz
*.fastq
*.fq
*.fq.gz
*.fasta
*.fasta.gz
*.fa
*.fa.gz
*.tbi
*.csi
*.bai
*.crai
*.fai
*.gzi
*.npy
*.npz
*.p5.b2.tmp*
*.pkl.b2.tmp*
*.log
*.png
*.csv
*.ped

# Explicitly curated readable real-data handoffs.
!deliverables/**/*.csv
!deliverables/**/*.ped

# Editor/patch leftovers and personal coding-tool configuration.
/.agents/
/.codex/
/.claude/
/.vscode/
/.env
/.env.*
!/.env.example
*.orig
*.patch-result
*.rej
*.swp
*~
.DS_Store
